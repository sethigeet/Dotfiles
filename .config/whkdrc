.shell powershell

# Reload whkd configuration
# alt + o                 : taskkill /f /im whkd.exe && start /b whkd # if shell is cmd
alt + o                 : taskkill /f /im whkd.exe; Start-Process whkd -WindowStyle hidden # if shell is pwsh / powershell
alt + shift + o         : komorebic reload-configuration

alt + q                 : komorebic close
alt + m                 : komorebic minimize

# Focus windows
# alt + h                 : komorebic focus left
# alt + j                 : komorebic focus down
# alt + k                 : komorebic focus up
# alt + l                 : komorebic focus right
alt + j                 : komorebic cycle-focus previous
alt + k                 : komorebic cycle-focus next

# Move windows
alt + ctrl + h          : komorebic move left
alt + ctrl + j          : komorebic move down
alt + ctrl + k          : komorebic move up
alt + ctrl + l          : komorebic move right
alt + shift + return    : komorebic promote

# Stack windows
# alt + left              : komorebic stack left
# alt + down              : komorebic stack down
# alt + up                : komorebic stack up
# alt + right             : komorebic stack right
# alt + oem_1             : komorebic unstack # oem_1 is ;
# alt + oem_4             : komorebic cycle-stack previous # oem_4 is [
# alt + oem_6             : komorebic cycle-stack next # oem_6 is ]
alt + a                 : komorebic cycle-stack previous
alt + d                 : komorebic cycle-stack next
alt + s                 : komorebic stack-all
alt + shift + s         : komorebic unstack-all

# Resize
alt + l         	      : komorebic resize-axis horizontal increase
alt + h               	: komorebic resize-axis horizontal decrease
alt + shift + k         : komorebic resize-axis vertical increase
alt + shift + j         : komorebic resize-axis vertical decrease

# Manipulate windows
alt + shift + f         : komorebic toggle-float
alt + f                 : komorebic toggle-monocle

# Workspaces
alt + 1                 : komorebic focus-workspace 0
alt + 2                 : komorebic focus-workspace 1
alt + 3                 : komorebic focus-workspace 2
alt + 4                 : komorebic focus-workspace 3
alt + 5                 : komorebic focus-workspace 4
alt + 6                 : komorebic focus-workspace 5
alt + oem_4             : komorebic cycle-workspace previous # oem_4 is [
alt + oem_6             : komorebic cycle-workspace next # oem_6 is ]
alt + oem_3             : komorebic focus-workspace $($(komorebic state | Select-String last_focused_workspace) -split ':')[-1][1]

# Move windows across workspaces
alt + shift + 1         : komorebic move-to-workspace 0
alt + shift + 2         : komorebic move-to-workspace 1
alt + shift + 3         : komorebic move-to-workspace 2
alt + shift + 4         : komorebic move-to-workspace 3
alt + shift + 5         : komorebic move-to-workspace 4
alt + shift + 6         : komorebic move-to-workspace 5

# App shortcuts - these require shell to be pwsh / powershell
# The apps will be focused if open, or launched if not open
# alt + f                 : if ($wshell.AppActivate('Firefox') -eq $False) { start firefox }
# alt + b                 : if ($wshell.AppActivate('Chrome') -eq $False) { start chrome }
alt + return            : start wt
# alt + return            : start C:\Users\geets\AppData\Local\Programs\Warp\warp.exe
# alt + w                 : start brave
# alt + shift + w         : start brave --incognito
alt + w                 : start C:\Users\geets\AppData\Local\imput\Helium\Application\chrome.exe
alt + shift + w         : start C:\Users\geets\AppData\Local\imput\Helium\Application\chrome.exe --incognito
alt + e                 : start explorer
alt + shift + e         : start code